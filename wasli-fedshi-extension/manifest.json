{
  "manifest_version": 3,
  "name": "وصلي - سحب منتجات الموردين الذكي (فدشي وموجود)",
  "version": "1.7.2",
  "description": "إضافة ذكية لنقل واستيراد منتجات منصتي فدشي وموجود بضغطة زر وقائمة الكليك الأيمن إلى منصة وصلي مع ضبط معادلات الأرباح وسحب الخيارات تلقائياً.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://web.fedshi.com/*",
    "https://mojod.app/*",
    "https://*.mojod.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "إعدادات منصة وصلي"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.fedshi.com/*",
        "https://mojod.app/*",
        "https://*.mojod.app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
