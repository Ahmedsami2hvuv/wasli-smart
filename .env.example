# ==========================================
# إعدادات بيئة منصة وصلي (Wasli Environment Variables)
# ==========================================

# رابط المنصة العام
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1. إعدادات سوبابيس (Supabase)
# تجد هذه البيانات في لوحة تحكم Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. إعدادات مستودع صور تيليجرام (Telegram Product Vault)
# يتم الحصول على الرمز من BotFather في تيليجرام
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# معرف القناة أو اسم القناة مثل @wasli_product_vault أو المعرف الرقمي -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=@wasli_product_vault

# 3. إعدادات التنبيهات والإشعارات الفورية
# معرف محادثة المشرف أو القناة الخاصة بإشعارات الطلبات الجديدة
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
