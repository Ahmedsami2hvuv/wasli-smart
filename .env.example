# ==========================================
# إعدادات بيئة منصة وصلي (Wasli Environment Variables)
# ==========================================

# رابط المنصة العام
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# 1. إعدادات سوبابيس (Supabase)
# ------------------------------------------
# تجد هذه البيانات في لوحة تحكم Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# 2. البوت الأول: بوت نشر المنتجات / المستودع (Telegram Product Vault Bot)
# ------------------------------------------
# التوكن الخاص ببوت نشر المنتجات بالقناة + رفع صور المنتجات + رموز تأكيد دخول التجار
TELEGRAM_VAULT_BOT_TOKEN=your_vault_bot_token_here
# معرف أو أيدي القناة الخاصة بتخزين/نشر صور المنتجات (مثال: -100xxxxxxxxxx أو @wasli_vault)
TELEGRAM_VAULT_CHANNEL_ID=@wasli_product_vault
# (اختياري) معرف محادثتك الخاصة مع بوت النشر لاستلام رموز التأكيد — إن تُرك فارغاً يُستخدم TELEGRAM_ADMIN_CHAT_ID
TELEGRAM_VAULT_ADMIN_CHAT_ID=

# ------------------------------------------
# 3. البوت الثاني: بوت إشعارات الطلبات للمتاجر والإدارة (Orders Notification Bot)
# ------------------------------------------
# التوكن الخاص بالبوت الثاني المخصص لإرسال الإشعارات الفورية بالطلبات الجديدة فقط
TELEGRAM_ORDERS_BOT_TOKEN=your_orders_bot_token_here
# معرف المحادثة أو القناة لإدارة منصة وصلي لاستلام نسخ من جميع الطلبات
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# ------------------------------------------
# 4. تواصل الإدارة لاسترجاع حساب التاجر (واتساب / تليكرام)
# ------------------------------------------
# رقم واتساب الإدارة بصيغة عراقية (مثال: 07701234567) — يظهر للتاجر بعد 5 دقائق من طلب الرمز
NEXT_PUBLIC_ADMIN_WHATSAPP=07701234567
# يوزر تليكرام الإدارة بدون @
NEXT_PUBLIC_ADMIN_TELEGRAM=wasli_support
# ملح تشفير رموز دخول التجار (اختياري لكن مستحسن تغييره في الإنتاج)
MERCHANT_PIN_PEPPER=change-me-to-a-long-random-secret
