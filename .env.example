# ==========================================
# إعدادات بيئة منصة وصلي (Wasli Environment Variables)
# ==========================================

# رابط المنصة العام
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# 1. إعدادات سوبابيس (Supabase)
# ------------------------------------------
# تجد هذه البيانات في لوحة تحكم Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# 2. البوت الأول: بوت مستودع صور المنتجات (Telegram Product Vault Bot)
# ------------------------------------------
# التوكن الخاص بالبوت الأول المخصص لرفع وتخزين صور المنتجات
TELEGRAM_VAULT_BOT_TOKEN=your_vault_bot_token_here
# معرف أو أيدي القناة الخاصة بتخزين صور المنتجات (مثال: -100xxxxxxxxxx أو @wasli_vault)
TELEGRAM_VAULT_CHANNEL_ID=@wasli_product_vault

# ------------------------------------------
# 3. البوت الثاني: بوت إشعارات الطلبات للمتاجر والإدارة (Orders Notification Bot)
# ------------------------------------------
# التوكن الخاص بالبوت الثاني المخصص لإرسال الإشعارات الفورية بالطلبات الجديدة
TELEGRAM_ORDERS_BOT_TOKEN=your_orders_bot_token_here
# معرف المحادثة أو القناة لإدارة منصة وصلي لاستلام نسخ من جميع الطلبات
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
